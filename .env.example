# Supabase Configuration (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site Configuration (REQUIRED)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SHOP_URL=https://yourdomain.com/order
NEXT_PUBLIC_CONTACT_EMAIL=info@yourdomain.com
NEXT_PUBLIC_CONTACT_PHONE=+9647XXXXXXXXX
NEXT_PUBLIC_CARD_PRICE=15000

# NextAuth Configuration (REQUIRED)
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://yourdomain.com

# Facebook Pixel (OPTIONAL - for marketing analytics)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-pixel-id
NEXT_PUBLIC_FB_PIXEL_ENABLED=true
